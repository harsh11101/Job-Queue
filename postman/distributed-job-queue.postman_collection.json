{
  "info": {
    "name": "Distributed Priority Job Queue",
    "description": "Distributed Priority Job Queue API. Run the folder in order: each create request stores the new job id in the `jobId` variable for the requests after it. 'Replay DLQ job' replays the permanent-failure job, so give it a second or two (Runner delay of 2000 ms) after that create. Re-running gives 200 instead of 201 for the fixed idempotency keys, and replay returns 409 once the job is no longer in DLQ.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jobId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "idempotencyKey",
      "value": "transfer-2026-0001"
    }
  ],
  "item": [
    {
      "name": "Create high-priority banking job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"transfer-2026-0001\",\n  \"type\": \"BANK_TRANSFER_SETTLEMENT\",\n  \"priority\": \"HIGH\",\n  \"payload\": {\n    \"from\": \"PL61109010140000071219812874\",\n    \"to\": \"PL27109010140000071219812875\",\n    \"amount\": \"1250.00\",\n    \"currency\": \"PLN\"\n  },\n  \"maxAttempts\": 4\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201 (or 200 when re-run)\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"jobId\", body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create same job again - idempotent 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"transfer-2026-0001\",\n  \"type\": \"BANK_TRANSFER_SETTLEMENT\",\n  \"priority\": \"HIGH\",\n  \"payload\": {\n    \"from\": \"PL61109010140000071219812874\",\n    \"to\": \"PL27109010140000071219812875\",\n    \"amount\": \"1250.00\",\n    \"currency\": \"PLN\"\n  },\n  \"maxAttempts\": 4\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"same job\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"jobId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create conflicting idempotency request - 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"transfer-2026-0001\",\n  \"type\": \"BANK_TRANSFER_SETTLEMENT\",\n  \"priority\": \"HIGH\",\n  \"payload\": {\n    \"from\": \"PL61109010140000071219812874\",\n    \"to\": \"PL27109010140000071219812875\",\n    \"amount\": \"9999.99\",\n    \"currency\": \"PLN\"\n  },\n  \"maxAttempts\": 4\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"conflict code\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_CONFLICT\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get job by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      }
    },
    {
      "name": "Get job attempts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}/attempts"
      }
    },
    {
      "name": "Get job by idempotency key",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/jobs/idempotency/{{idempotencyKey}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "List jobs (newest first)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"has items\", () => pm.expect(pm.response.json().items).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/jobs?page=0&size=20"
      }
    },
    {
      "name": "List jobs filtered (HIGH, SUCCEEDED, created this year)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/jobs?status=SUCCEEDED&priority=HIGH&type=bank_transfer_settlement&createdFrom=2026-01-01T00:00:00Z&page=0&size=10"
      }
    },
    {
      "name": "Get unknown job - 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/jobs/00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "name": "Create retryable failure simulation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"retry-demo-0001\",\n  \"type\": \"RETRYABLE_DEMO\",\n  \"priority\": \"LOW\",\n  \"payload\": {\"simulateRetryableFailure\": true},\n  \"maxAttempts\": 3\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201 or 200\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"jobId\", body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create permanent failure simulation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"permanent-demo-0001\",\n  \"type\": \"PERMANENT_DEMO\",\n  \"priority\": \"LOW\",\n  \"payload\": {\"simulatePermanentFailure\": true},\n  \"maxAttempts\": 4\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201 or 200\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"jobId\", body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay DLQ job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}/replay",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"priority\": \"HIGH\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Replays the permanent-failure job created just before; it reaches DLQ within about a second.",
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"back to QUEUED\", () => pm.expect(pm.response.json().status).to.eql(\"QUEUED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Stats",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/jobs/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Prometheus metrics",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/prometheus"
      }
    }
  ]
}
