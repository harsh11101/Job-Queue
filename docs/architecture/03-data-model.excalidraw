      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "job_outbox\n\nPK  id\nFK  job_id → jobs.id\n      topic · message_key (= idempotency key)\n      payload_json · headers_json\n      status: PENDING | PUBLISHING |\n                  PUBLISHED | FAILED\n      attempts · not_before\n      created_at · updated_at · published_at\n      last_error\n\nIX  (status, not_before, created_at)\n       WHERE status = 'PENDING'\nIX  job_id",
      "originalText": "job_outbox\n\nPK  id\nFK  job_id → jobs.id\n      topic · message_key (= idempotency key)\n      payload_json · headers_json\n      status: PENDING | PUBLISHING |\n                  PUBLISHED | FAILED\n      attempts · not_before\n      created_at · updated_at · published_at\n      last_error\n\nIX  (status, not_before, created_at)\n       WHERE status = 'PENDING'\nIX  job_id",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "outbox",
      "lineHeight": 1.25,
      "autoResize": true
    },
