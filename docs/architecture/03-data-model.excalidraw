    {
      "id": "jobs-text",
      "type": "text",
      "x": 532,
      "y": 132,
      "width": 376,
      "height": 297.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 5,
      "version": 1,
      "versionNonce": 5,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "jobs\n\nPK  id  UUID\nUQ  idempotency_key\n      request_hash  (SHA-256 of key, type, priority, payload)\n      type · priority · status\n      payload_json · result_json\n      error_message · failure_class\n      attempt · max_attempts\n      next_retry_at\n      leased_until · worker_id · locked_at\n      trace_id · version\n      created_at · updated_at · completed_at\n\nIX  (status, created_at DESC)\nIX  (priority, status, created_at DESC)\nIX  next_retry_at  WHERE NOT NULL",
      "originalText": "jobs\n\nPK  id  UUID\nUQ  idempotency_key\n      request_hash  (SHA-256 of key, type, priority, payload)\n      type · priority · status\n      payload_json · result_json\n      error_message · failure_class\n      attempt · max_attempts\n      next_retry_at\n      leased_until · worker_id · locked_at\n      trace_id · version\n      created_at · updated_at · completed_at\n\nIX  (status, created_at DESC)\nIX  (priority, status, created_at DESC)\nIX  next_retry_at  WHERE NOT NULL",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "jobs",
      "lineHeight": 1.25,
      "autoResize": true
    },
