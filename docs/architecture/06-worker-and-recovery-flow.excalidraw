    {
      "id": "note-87",
      "type": "text",
      "x": 70,
      "y": 1035,
      "width": 863.0400000000001,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 87,
      "version": 1,
      "versionNonce": 87,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why recovery is needed: a dead worker's message is redelivered within seconds, while its 6-minute lease is still held,\nso the redelivery is skipped (s1). Recovery moves the job on once the lease has expired: at most about 6.5 minutes.",
      "originalText": "Why recovery is needed: a dead worker's message is redelivered within seconds, while its 6-minute lease is still held,\nso the redelivery is skipped (s1). Recovery moves the job on once the lease has expired: at most about 6.5 minutes.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
