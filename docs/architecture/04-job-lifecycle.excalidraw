    {
      "id": "note-38",
      "type": "text",
      "x": 60,
      "y": 790,
      "width": 929.1200000000001,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 38,
      "version": 1,
      "versionNonce": 38,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Retry delays are set by app.job-queue.retry.* (first 5 s, second 30 s, every later one 2 min).\nmaxAttempts defaults to 4 (1–20 per job). Messages for a SUCCEEDED, DLQ or CANCELLED job are acknowledged and skipped.\nCancel is refused (409) for PROCESSING and SUCCEEDED jobs; a cancel and a worker starting the job cannot both win.",
      "originalText": "Retry delays are set by app.job-queue.retry.* (first 5 s, second 30 s, every later one 2 min).\nmaxAttempts defaults to 4 (1–20 per job). Messages for a SUCCEEDED, DLQ or CANCELLED job are acknowledged and skipped.\nCancel is refused (409) for PROCESSING and SUCCEEDED jobs; a cancel and a worker starting the job cannot both win.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
